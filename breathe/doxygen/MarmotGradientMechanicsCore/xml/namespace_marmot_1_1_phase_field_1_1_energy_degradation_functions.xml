      <memberdef kind="function" id="_marmot_phase_field_energy_degradation_8h_1af31c2bef36e05bb707f5eb4ab9d8f8c1" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <templateparamlist>
