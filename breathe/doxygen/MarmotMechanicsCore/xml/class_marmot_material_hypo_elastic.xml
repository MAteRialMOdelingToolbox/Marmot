        <definition>virtual void MarmotMaterialHypoElastic::computeStress</definition>
        <argsstring>(state3D &amp;state, Marmot::Matrix6d &amp;dStress_dStrain, const Marmot::Vector6d &amp;dStrain, const timeInfo &amp;timeInfo) const =0</argsstring>
        <name>computeStress</name>
        <qualifiedname>MarmotMaterialHypoElastic::computeStress</qualifiedname>
        <reimplementedby refid="class_marmot_material_hypo_elastic_a_d_1a0e9ccf3ea4764526ef87a933a2575ea1">computeStress</reimplementedby>
        <param>
          <type><ref refid="struct_marmot_material_hypo_elastic_1_1state3_d" kindref="compound">state3D</ref> &amp;</type>
          <declname>state</declname>
        </param>
        <param>
          <type>Marmot::Matrix6d &amp;</type>
          <declname>dStress_dStrain</declname>
        </param>
        <param>
          <type>const Marmot::Vector6d &amp;</type>
          <declname>dStrain</declname>
        </param>
        <param>
          <type>const <ref refid="struct_marmot_material_hypo_elastic_1_1time_info" kindref="compound">timeInfo</ref> &amp;</type>
          <declname>timeInfo</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>For a given linearized strain increment <formula id="52">$\Delta\boldsymbol{\varepsilon}$</formula> at the old and the current time, compute the Cauchy stress and the algorithmic tangent <formula id="53">$\frac{\partial\boldsymbol{\sigma}^{(n+1)}}{\partial\boldsymbol{\varepsilon}^{(n+1)}}$</formula>.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="inout">state</parametername>
</parameternamelist>
<parameterdescription>
<para>A <ref refid="struct_marmot_material_hypo_elastic_1_1state3_d" kindref="compound">state3D</ref> instance carrying stress, strain energy, and state variables </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="inout">dStress_dStrain</parametername>
</parameternamelist>
<parameterdescription>
<para>Algorithmic tangent representing the derivative of the Cauchy stress tensor with respect to the linearized strain </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">dStrain</parametername>
</parameternamelist>
<parameterdescription>
<para>linearized strain increment </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in"><ref refid="struct_marmot_material_hypo_elastic_1_1time_info" kindref="compound">timeInfo</ref></parametername>
</parameternamelist>
<parameterdescription>
<para>Structure carrying the current (pseudo-)time and the (pseudo-)time increment </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
