        <definition>double Marmot::ContinuumMechanics::Viscoelasticity::DiscreteSpectrum::evaluatePostWidderFormula</definition>
        <argsstring>(std::function&lt; autodiff::Real&lt; k, double &gt;(autodiff::Real&lt; k, double &gt;) &gt; function, double tau, PostWidderCoefficientSign coefficientSign)</argsstring>
        <name>evaluatePostWidderFormula</name>
        <qualifiedname>Marmot::ContinuumMechanics::Viscoelasticity::DiscreteSpectrum::evaluatePostWidderFormula</qualifiedname>
        <param>
          <type>std::function&lt; autodiff::Real&lt; k, double &gt;(autodiff::Real&lt; k, double &gt;) &gt;</type>
          <declname>function</declname>
        </param>
        <param>
          <type>double</type>
          <declname>tau</declname>
        </param>
        <param>
          <type>PostWidderCoefficientSign</type>
          <declname>coefficientSign</declname>
        </param>
        <briefdescription>
<para>Evaluate the Post-Widder formula of order <formula id="12">$k$</formula>. </para>
        </briefdescription>
        <detaileddescription>
<para>Computes <formula id="13">$\pm \frac{(-k\tau)^k}{(k-1)!} \, f^{(k)}(k\tau)$</formula>, with the derivative of order <formula id="12">$k$</formula> obtained by automatic differentiation.</para>
<para><parameterlist kind="templateparam"><parameteritem>
<parameternamelist>
<parametername>k</parametername>
</parameternamelist>
<parameterdescription>
<para>order of the approximation </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">function</parametername>
</parameternamelist>
<parameterdescription>
<para>function to be inverted, e.g. a relaxation or retardation function </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">tau</parametername>
</parameternamelist>
<parameterdescription>
<para>relaxation or retardation time at which the spectrum is evaluated </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">coefficientSign</parametername>
</parameternamelist>
<parameterdescription>
<para>sign of the coefficient </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>the value of the approximated spectrum at <formula id="14">$\tau$</formula> </para>
</simplesect>
</para>
        </detaileddescription>
