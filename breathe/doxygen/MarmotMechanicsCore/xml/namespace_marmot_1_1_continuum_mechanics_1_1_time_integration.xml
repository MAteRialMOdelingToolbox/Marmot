</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="inout">v</parametername>
</parameternamelist>
<parameterdescription>
<para>Velocity: <formula id="107">$ v_n $</formula> on entry, <formula id="100">$ v_{n+1} $</formula> on return. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="inout">a</parametername>
</parameternamelist>
<parameterdescription>
<para>Acceleration: <formula id="108">$ a_n $</formula> on entry, <formula id="99">$ a_{n+1} $</formula> on return. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">dT</parametername>
</parameternamelist>
