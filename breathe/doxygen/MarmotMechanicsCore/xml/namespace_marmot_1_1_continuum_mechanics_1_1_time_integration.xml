<parametername direction="out">da_ddu</parametername>
</parameternamelist>
<parameterdescription>
<para>Derivative <formula id="113">$ \partial a_{n+1} / \partial \Delta u $</formula>, an nDim x nDim matrix (column major); only its diagonal is written. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
