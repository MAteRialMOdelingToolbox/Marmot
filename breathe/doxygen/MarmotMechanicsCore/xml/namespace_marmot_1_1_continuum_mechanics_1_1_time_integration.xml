<para>Time increment <formula id="109">$ \Delta t \geq 0 $</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">newmarkBeta</parametername>
</parameternamelist>
<parameterdescription>
<para>Newmark parameter <formula id="110">$ \beta $</formula> (1/4 with <formula id="111">$ \gamma = 1/2 $</formula>: the average acceleration rule; 0: no time integration). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">newmarkGamma</parametername>
</parameternamelist>
<parameterdescription>
<para>Newmark parameter <formula id="112">$ \gamma $</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
