      <memberdef kind="function" id="_marmot_wiechert_8h_1a4b0ac5c4236dcf66bf761a55bd2a2023" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>Properties</type>
        <definition>Properties Marmot::ContinuumMechanics::Viscoelasticity::Wiechert::generateRelaxationTimes</definition>
        <argsstring>(int n, double min, double spacing)</argsstring>
        <name>generateRelaxationTimes</name>
        <qualifiedname>Marmot::ContinuumMechanics::Viscoelasticity::Wiechert::generateRelaxationTimes</qualifiedname>
        <param>
          <type>int</type>
          <declname>n</declname>
        </param>
        <param>
          <type>double</type>
          <declname>min</declname>
        </param>
        <param>
          <type>double</type>
          <declname>spacing</declname>
        </param>
        <briefdescription>
<para>Generate logarithmically spaced relaxation times. </para>
        </briefdescription>
        <detaileddescription>
<para>The relaxation times are <formula id="6">$\tau_i = \mathrm{min} \cdot \mathrm{spacing}^i$</formula> for <formula id="7">$i = 0, \dots, n-1$</formula>.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">n</parametername>
</parameternamelist>
<parameterdescription>
<para>number of relaxation times </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">min</parametername>
</parameternamelist>
<parameterdescription>
<para>smallest relaxation time </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">spacing</parametername>
</parameternamelist>
<parameterdescription>
<para>ratio of two consecutive relaxation times </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>the relaxation times </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/home/runner/work/Marmot/Marmot/modules/core/MarmotMechanicsCore/include/Marmot/MarmotWiechert.h" line="107" column="14" declfile="/home/runner/work/Marmot/Marmot/modules/core/MarmotMechanicsCore/include/Marmot/MarmotWiechert.h" declline="107" declcolumn="14"/>
      </memberdef>
      <memberdef kind="function" id="_marmot_wiechert_8h_1a4c1b978973063aaa7658911f5dcd7b87" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void Marmot::ContinuumMechanics::Viscoelasticity::Wiechert::updateStateVarMatrix</definition>
        <argsstring>(const double dT, const Properties &amp;elasticModuli, const Properties &amp;relaxationTimes, Eigen::Ref&lt; StateVarMatrix &gt; stateVars, const Marmot::Math::Vector6d &amp;dStrain, const Marmot::Math::Matrix6d &amp;unitD_ijkl)</argsstring>
        <name>updateStateVarMatrix</name>
        <qualifiedname>Marmot::ContinuumMechanics::Viscoelasticity::Wiechert::updateStateVarMatrix</qualifiedname>
        <param>
          <type>const double</type>
          <declname>dT</declname>
        </param>
        <param>
          <type>const Properties &amp;</type>
          <declname>elasticModuli</declname>
        </param>
        <param>
          <type>const Properties &amp;</type>
          <declname>relaxationTimes</declname>
        </param>
        <param>
          <type>Eigen::Ref&lt; StateVarMatrix &gt;</type>
          <declname>stateVars</declname>
        </param>
        <param>
          <type>const Marmot::Math::Vector6d &amp;</type>
          <declname>dStrain</declname>
        </param>
        <param>
          <type>const Marmot::Math::Matrix6d &amp;</type>
          <declname>unitD_ijkl</declname>
        </param>
        <briefdescription>
<para>Update the stresses of the Maxwell units for a strain increment. </para>
        </briefdescription>
        <detaileddescription>
<para>For every unit <formula id="8">$i$</formula> the stress is updated with the exponential algorithm, <formula id="9">$\sigma_i \leftarrow \lambda_i D_i \, \mathbb{C}_1 \, \Delta\varepsilon + \beta_i \sigma_i$</formula>, where <formula id="10">$\lambda_i$</formula> and <formula id="11">$\beta_i$</formula> follow from the time increment and the relaxation time of the unit. Nothing is updated for a vanishing time increment.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">dT</parametername>
</parameternamelist>
<parameterdescription>
<para>time increment </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">elasticModuli</parametername>
</parameternamelist>
<parameterdescription>
<para>elastic moduli <formula id="12">$D_i$</formula> of the Maxwell units </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">relaxationTimes</parametername>
</parameternamelist>
<parameterdescription>
<para>relaxation times of the Maxwell units </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="inout">stateVars</parametername>
</parameternamelist>
<parameterdescription>
<para>stresses of the Maxwell units in Voigt notation, one column per unit </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">dStrain</parametername>
</parameternamelist>
<parameterdescription>
<para>strain increment in Voigt notation </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">unitD_ijkl</parametername>
</parameternamelist>
<parameterdescription>
<para>stiffness tensor <formula id="13">$\mathbb{C}_1$</formula> for a unit Young&apos;s modulus in Voigt notation </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
