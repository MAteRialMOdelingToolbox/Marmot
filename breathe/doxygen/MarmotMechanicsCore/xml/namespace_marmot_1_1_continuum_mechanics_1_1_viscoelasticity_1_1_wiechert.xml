      <memberdef kind="function" id="_marmot_wiechert_8h_1a4091dc204de492104c927d30402ea717" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void Marmot::ContinuumMechanics::Viscoelasticity::Wiechert::evaluateWiechert</definition>
        <argsstring>(const double dT, const Properties &amp;elasticModuli, const Properties &amp;relaxationTimes, Eigen::Ref&lt; StateVarMatrix &gt; stateVars, double &amp;uniaxialStiffness, Marmot::Math::Vector6d &amp;dStress, const double factor)</argsstring>
        <name>evaluateWiechert</name>
        <qualifiedname>Marmot::ContinuumMechanics::Viscoelasticity::Wiechert::evaluateWiechert</qualifiedname>
        <param>
          <type>const double</type>
          <declname>dT</declname>
        </param>
        <param>
          <type>const Properties &amp;</type>
          <declname>elasticModuli</declname>
        </param>
        <param>
          <type>const Properties &amp;</type>
          <declname>relaxationTimes</declname>
        </param>
        <param>
          <type>Eigen::Ref&lt; StateVarMatrix &gt;</type>
          <declname>stateVars</declname>
        </param>
        <param>
          <type>double &amp;</type>
          <declname>uniaxialStiffness</declname>
        </param>
        <param>
          <type>Marmot::Math::Vector6d &amp;</type>
          <declname>dStress</declname>
        </param>
        <param>
          <type>const double</type>
          <declname>factor</declname>
        </param>
        <briefdescription>
<para>Accumulate the contribution of the Maxwell units to the stiffness and to the stress relaxation. </para>
        </briefdescription>
        <detaileddescription>
<para>For every unit <formula id="8">$i$</formula> the algorithmic stiffness <formula id="14">$\lambda_i D_i$</formula> is added to <computeroutput>uniaxialStiffness</computeroutput> and the stress <formula id="15">$(1 - \beta_i) \sigma_i$</formula> released by relaxation during the increment is added to <computeroutput>dStress</computeroutput>, both multiplied by <computeroutput>factor</computeroutput>.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">dT</parametername>
</parameternamelist>
<parameterdescription>
<para>time increment </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">elasticModuli</parametername>
</parameternamelist>
<parameterdescription>
<para>elastic moduli <formula id="12">$D_i$</formula> of the Maxwell units </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">relaxationTimes</parametername>
</parameternamelist>
<parameterdescription>
<para>relaxation times of the Maxwell units </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">stateVars</parametername>
</parameternamelist>
<parameterdescription>
<para>stresses <formula id="16">$\sigma_i$</formula> of the Maxwell units at the beginning of the increment </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="inout">uniaxialStiffness</parametername>
</parameternamelist>
<parameterdescription>
<para>accumulated algorithmic stiffness of the Maxwell units </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="inout">dStress</parametername>
</parameternamelist>
<parameterdescription>
<para>accumulated stress released by relaxation, in Voigt notation </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">factor</parametername>
</parameternamelist>
<parameterdescription>
<para>scalar weight of the contribution </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
