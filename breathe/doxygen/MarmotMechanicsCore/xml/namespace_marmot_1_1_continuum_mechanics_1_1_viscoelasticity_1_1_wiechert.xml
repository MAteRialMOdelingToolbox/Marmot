        <type>double</type>
        <definition>double Marmot::ContinuumMechanics::Viscoelasticity::Wiechert::evaluatePostWidderFormula</definition>
        <argsstring>(std::function&lt; autodiff::Real&lt; k, double &gt;(autodiff::Real&lt; k, double &gt;) &gt; psi, double tau)</argsstring>
        <name>evaluatePostWidderFormula</name>
        <qualifiedname>Marmot::ContinuumMechanics::Viscoelasticity::Wiechert::evaluatePostWidderFormula</qualifiedname>
        <param>
          <type>std::function&lt; autodiff::Real&lt; k, double &gt;(autodiff::Real&lt; k, double &gt;) &gt;</type>
          <declname>psi</declname>
        </param>
        <param>
          <type>double</type>
          <declname>tau</declname>
        </param>
        <briefdescription>
<para>Evaluate the Post-Widder formula of order <formula id="0">$k$</formula> for a relaxation function. </para>
        </briefdescription>
        <detaileddescription>
<para>Approximates the relaxation spectrum of the relaxation function <formula id="1">$\psi$</formula> at the relaxation time <formula id="2">$\tau$</formula>. The derivative of order <formula id="0">$k$</formula> is obtained by automatic differentiation.</para>
<para><parameterlist kind="templateparam"><parameteritem>
<parameternamelist>
<parametername>k</parametername>
</parameternamelist>
<parameterdescription>
<para>order of the Post-Widder approximation </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">psi</parametername>
</parameternamelist>
<parameterdescription>
<para>relaxation function </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">tau</parametername>
</parameternamelist>
<parameterdescription>
<para>relaxation time at which the spectrum is evaluated </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>the relaxation spectrum at <formula id="2">$\tau$</formula> </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
