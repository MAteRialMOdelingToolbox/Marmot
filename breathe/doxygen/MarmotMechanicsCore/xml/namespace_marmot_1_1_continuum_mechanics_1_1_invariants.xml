      <memberdef kind="function" id="_marmot_voigt_8h_1a4c28e39dcd747fad01269fab76fb20c0" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>Eigen::Vector3d</type>
        <definition>Eigen::Vector3d Marmot::ContinuumMechanics::Invariants::sortedPrincipalStrains</definition>
        <argsstring>(const Marmot::Math::Vector6d &amp;strain)</argsstring>
        <name>sortedPrincipalStrains</name>
        <qualifiedname>Marmot::ContinuumMechanics::Invariants::sortedPrincipalStrains</qualifiedname>
        <param>
          <type>const Marmot::Math::Vector6d &amp;</type>
          <declname>strain</declname>
        </param>
        <briefdescription>
<para>Computes the principal strains from Haigh–Westergaard coordinates. </para>
        </briefdescription>
        <detaileddescription>
<para>This function transforms the Haigh–Westergaard coordinates <formula id="172">$ (\xi, \rho, \theta) $</formula> into the corresponding principal strains <formula id="168">$ \varepsilon_1, \varepsilon_2, \varepsilon_3 $</formula> using:                    <formula id="173">\[  \begin{bmatrix}
    \varepsilon_{1} \\
    \varepsilon_{2} \\
    \varepsilon_{3}
  \end{bmatrix}
  =
  \frac{1}{\sqrt{3}}
  \begin{bmatrix}
    \xi \\
    \xi \\
    \xi
  \end{bmatrix}
  + \sqrt{\tfrac{2}{3}}\, \rho \,
  \begin{bmatrix}
    \cos(\theta) \\
    -\sin\!\left(\tfrac{\pi}{6} - \theta\right) \\
    -\sin\!\left(\tfrac{\pi}{6} + \theta\right)
  \end{bmatrix}
\]</formula> <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>strain</parametername>
</parameternamelist>
<parameterdescription>
<para>6-component strain vector in Voigt notation. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>A 3D vector of the principal strains, sorted by magnitude. </para>
</simplesect>
<simplesect kind="note"><para>The computation of <formula id="174">$ \xi $</formula>, <formula id="175">$ \rho $</formula>, and <formula id="176">$ \theta $</formula> is performed in <computeroutput>haighWestergaardFromStrain()</computeroutput>. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
