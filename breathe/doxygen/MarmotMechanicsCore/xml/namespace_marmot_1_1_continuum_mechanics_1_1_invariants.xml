        <definition>T Marmot::ContinuumMechanics::Invariants::I2</definition>
        <argsstring>(const Eigen::Matrix&lt; T, 6, 1 &gt; &amp;stress)</argsstring>
        <name>I2</name>
        <qualifiedname>Marmot::ContinuumMechanics::Invariants::I2</qualifiedname>
        <param>
