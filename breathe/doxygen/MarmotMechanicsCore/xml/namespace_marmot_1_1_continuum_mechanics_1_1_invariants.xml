      </memberdef>
      <memberdef kind="function" id="_marmot_voigt_8h_1a52f201bf9d6e00eb4d3209100e6d44f8" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>Eigen::Matrix3d</type>
        <definition>Eigen::Matrix3d Marmot::ContinuumMechanics::Invariants::principalStressesDirections</definition>
        <argsstring>(const Marmot::Math::Vector6d &amp;stress)</argsstring>
        <name>principalStressesDirections</name>
        <qualifiedname>Marmot::ContinuumMechanics::Invariants::principalStressesDirections</qualifiedname>
        <param>
          <type>const Marmot::Math::Vector6d &amp;</type>
          <declname>stress</declname>
        </param>
        <briefdescription>
<para>Computes the principal stress directions corresponding to the principal stresses. </para>
        </briefdescription>
        <detaileddescription>
<para>This function solves the eigenvalue problem    <formula id="177">\[  \left( \boldsymbol{\sigma} - \sigma_k \cdot \boldsymbol{I} \right) \cdot
  \boldsymbol{x}^{(k)} = 0
\]</formula> to obtain the eigenvectors <formula id="178">$ \boldsymbol{x}^{(k)} $</formula> associated with the principal stresses <formula id="179">$ \sigma_k $</formula>. <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>stress</parametername>
</parameternamelist>
<parameterdescription>
<para>6-component stress vector in Voigt notation. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>A 3x3 matrix whose columns are the principal stress directions (unsorted). </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
