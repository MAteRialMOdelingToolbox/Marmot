<parameternamelist>
<parametername>stress</parametername>
</parameternamelist>
<parameterdescription>
<para>6-component stress vector in Voigt notation. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The von Mises equivalent stress. </para>
</simplesect>
</para>
        </detaileddescription>
