      <memberdef kind="function" id="_marmot_voigt_8h_1aa1fcb6767018ef87d876e2cb0e9ed00f" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>Marmot::Math::Matrix36d</type>
        <definition>Marmot::Math::Matrix36d Marmot::ContinuumMechanics::Voigt::Transformations::projectVoigtStressToPlane</definition>
        <argsstring>(const Marmot::Math::Vector3d &amp;normalVector)</argsstring>
        <name>projectVoigtStressToPlane</name>
        <qualifiedname>Marmot::ContinuumMechanics::Voigt::Transformations::projectVoigtStressToPlane</qualifiedname>
        <param>
          <type>const Marmot::Math::Vector3d &amp;</type>
          <declname>normalVector</declname>
        </param>
        <briefdescription>
<para>Calculates the projection matrix for mapping Voigt stress to a traction vector. </para>
        </briefdescription>
        <detaileddescription>
<para>This function returns the <formula id="313">$3 \times 6$</formula> projection matrix <formula id="314">$\mathbf{P}^{(\mathbf{n})}$</formula> that maps a <bold>Voigt-notated stress vector</bold> <formula id="315">$\boldsymbol{\sigma}_{\text{voigt}} \in \mathbb{R}^6$</formula> to the <bold>traction vector</bold> <formula id="316">$\mathbf{t}^{(\mathbf{n})} \in \mathbb{R}^3$</formula> on a plane with an outward unit normal vector <formula id="99">$\mathbf{n}$</formula>. The relationship is given by:   <formula id="317">\[\mathbf{t}^{(\mathbf{n})} = \mathbf{P}^{(\mathbf{n})} \, \boldsymbol{\sigma}_{\text{voigt}}.
\]</formula> This expression is mathematically equivalent to Cauchy&apos;s formula  <formula id="318">$ \boldsymbol{t}^{(n)}_i =
\sigma_{ji} \, n_j $</formula>. <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>normalVector</parametername>
</parameternamelist>
<parameterdescription>
<para>The <formula id="319">$3 \times 1$</formula> <bold>unit vector</bold> <formula id="99">$\mathbf{n}$</formula> representing the <bold>normal</bold> of the plane. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The <formula id="313">$3 \times 6$</formula> projection matrix <formula id="314">$\mathbf{P}^{(\mathbf{n})}$</formula>. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
