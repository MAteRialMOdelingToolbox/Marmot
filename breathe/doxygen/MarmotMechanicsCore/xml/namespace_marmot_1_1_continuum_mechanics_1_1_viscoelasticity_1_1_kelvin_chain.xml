        <definition>void Marmot::ContinuumMechanics::Viscoelasticity::KelvinChain::updateStateVarMatrix</definition>
        <argsstring>(const double dT, Properties elasticModuli, Properties retardationTimes, Eigen::Ref&lt; StateVarMatrix &gt; stateVars, const Marmot::Math::Vector6d &amp;dStress, const Marmot::Math::Matrix6d &amp;unitComplianceMatrix)</argsstring>
        <name>updateStateVarMatrix</name>
        <qualifiedname>Marmot::ContinuumMechanics::Viscoelasticity::KelvinChain::updateStateVarMatrix</qualifiedname>
        <param>
