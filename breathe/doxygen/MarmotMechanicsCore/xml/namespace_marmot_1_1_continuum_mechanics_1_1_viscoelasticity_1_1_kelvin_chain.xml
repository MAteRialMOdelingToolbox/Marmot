      </memberdef>
      <memberdef kind="function" id="_marmot_kelvin_chain_8h_1a7f1993c99a33ecb172e5aa5c300d6534" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <templateparamlist>
          <param>
