          <type>Eigen::Matrix&lt; T, 6, <ref refid="class_marmot_1_1_continuum_mechanics_1_1_microplane_1_1_n_t_split_1ac4c4bf30b23d1e109496ecd4328b7340" kindref="member">nqp</ref> &gt;</type>
