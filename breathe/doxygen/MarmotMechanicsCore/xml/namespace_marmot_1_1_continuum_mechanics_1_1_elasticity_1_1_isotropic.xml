        <briefdescription>
<para>Computes the isotropic Young&apos;s modulus <formula id="144">$ E $</formula> from the compression modulus <formula id="145">$ K $</formula> and shear modulus <formula id="146">$ G $</formula>. </para>
        </briefdescription>
        <detaileddescription>
<para><formula id="147">\[  \displaystyle E = \frac{9\,K\,G}{3\,K + G}
\]</formula></para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>K</parametername>
</parameternamelist>
<parameterdescription>
<para>Compression modulus <formula id="145">$ K $</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>G</parametername>
</parameternamelist>
<parameterdescription>
<para>Shear modulus <formula id="146">$ G $</formula>. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Young&apos;s modulus <formula id="144">$ E $</formula>. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
