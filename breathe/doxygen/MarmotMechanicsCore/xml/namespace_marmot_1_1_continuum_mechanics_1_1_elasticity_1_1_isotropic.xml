        <definition>double constexpr Marmot::ContinuumMechanics::Elasticity::Isotropic::nu</definition>
        <argsstring>(const double K, const double G)</argsstring>
        <name>nu</name>
        <qualifiedname>Marmot::ContinuumMechanics::Elasticity::Isotropic::nu</qualifiedname>
        <param>
          <type>const double</type>
          <declname>K</declname>
        </param>
        <param>
          <type>const double</type>
          <declname>G</declname>
        </param>
        <briefdescription>
<para>Computes the isotropic Poisson&apos;s ratio <formula id="148">$ \nu $</formula> from the compression modulus <formula id="145">$ K $</formula> and shear modulus <formula id="146">$ G $</formula>. </para>
        </briefdescription>
        <detaileddescription>
<para><formula id="149">\[  \displaystyle \nu = \frac{3\,K - 2\,G}{6\,K + 2\,G}
\]</formula></para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>K</parametername>
</parameternamelist>
<parameterdescription>
<para>Compression modulus <formula id="145">$ K $</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>G</parametername>
</parameternamelist>
<parameterdescription>
<para>Shear modulus <formula id="146">$ G $</formula>. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Poisson&apos;s ratio <formula id="148">$ \nu $</formula>. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
