        <briefdescription>
<para>Computes the transversely isotropic stiffness tensor <formula id="58">$ \mathbb{C} $</formula> as inverse of the transversely isotropic compliance tensor <formula id="59">$ \mathbb{C}^{-1} $</formula>. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>E1</parametername>
</parameternamelist>
<parameterdescription>
<para>Out-of-plane Young&apos;s modulus <formula id="53">$E_1$</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>E2</parametername>
</parameternamelist>
