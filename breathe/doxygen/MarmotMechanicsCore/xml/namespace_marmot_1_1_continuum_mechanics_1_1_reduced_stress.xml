        <definition>auto Marmot::ContinuumMechanics::ReducedStress::computeReducedStress</definition>
        <argsstring>(StressUpdate3D &amp;&amp;computeStress3D, Marmot::Math::Vector6d &amp;dStrain, const std::array&lt; int, nP_ &gt; &amp;p, const std::array&lt; int, nF_ &gt; &amp;f)</argsstring>
        <name>computeReducedStress</name>
        <qualifiedname>Marmot::ContinuumMechanics::ReducedStress::computeReducedStress</qualifiedname>
        <param>
          <type>StressUpdate3D &amp;&amp;</type>
          <declname>computeStress3D</declname>
        </param>
        <param>
          <type>Marmot::Math::Vector6d &amp;</type>
