      <memberdef kind="function" id="_marmot_interface_material_helper_functions_8h_1aa9ef94ca150f62d505cb25df51ae5d72" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>std::tuple&lt; Tensor3333d, Tensor33d, Tensor333d, Tensor3333d &gt;</type>
        <definition>std::tuple&lt; Tensor3333d, Tensor33d, Tensor333d, Tensor3333d &gt; Marmot::Materials::InterfaceMaterialHelperFunctions::calculateInterfaceMaterialParameters</definition>
        <argsstring>(const Tensor3d &amp;normal, const double &amp;nu_0)</argsstring>
        <name>calculateInterfaceMaterialParameters</name>
        <qualifiedname>Marmot::Materials::InterfaceMaterialHelperFunctions::calculateInterfaceMaterialParameters</qualifiedname>
        <param>
          <type>const Tensor3d &amp;</type>
          <declname>normal</declname>
        </param>
        <param>
          <type>const double &amp;</type>
          <declname>nu_0</declname>
        </param>
        <briefdescription>
<para>Calculates interface material parameters from a normal vector and Poisson&apos;s ratio. </para>
        </briefdescription>
        <detaileddescription>
<para>This overload computes interface material matrices assuming an isotropic elastic material defined by a normal direction and Poisson&apos;s ratio. The elastic properties are derived from these parameters.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">normal</parametername>
</parameternamelist>
<parameterdescription>
<para>3-component unit normal vector to the interface </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">nu_0</parametername>
</parameternamelist>
<parameterdescription>
<para>Poisson&apos;s ratio of the interface material</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>A tuple containing four tensors:<itemizedlist>
<listitem><para>Tensor3333d: 1st material matrix parameter (4th-order tensor)</para>
</listitem><listitem><para>Tensor33d: 2nd material matrix parameter (2nd-order tensor)</para>
</listitem><listitem><para>Tensor333d: 3rd material matrix parameter (3rd-order tensor)</para>
</listitem><listitem><para>Tensor3333d: 4th material matrix parameter (4th-order tensor) </para>
</listitem></itemizedlist>
</para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
