      <memberdef kind="function" id="_marmot_interface_material_helper_functions_8h_1a18b5f6da796e248890273b73cf0dc65f" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>std::tuple&lt; Tensor3333d, Tensor33d, Tensor333d, Tensor3333d &gt;</type>
        <definition>std::tuple&lt; Tensor3333d, Tensor33d, Tensor333d, Tensor3333d &gt; Marmot::Materials::InterfaceMaterialHelperFunctions::calculateMaterialMatrices</definition>
        <argsstring>(const Tensor3d &amp;normal, const Tensor33d &amp;N, const Tensor3333d &amp;C_nu_aibj)</argsstring>
        <name>calculateMaterialMatrices</name>
        <qualifiedname>Marmot::Materials::InterfaceMaterialHelperFunctions::calculateMaterialMatrices</qualifiedname>
        <param>
          <type>const Tensor3d &amp;</type>
          <declname>normal</declname>
        </param>
        <param>
          <type>const Tensor33d &amp;</type>
          <declname>N</declname>
        </param>
        <param>
          <type>const Tensor3333d &amp;</type>
          <declname>C_nu_aibj</declname>
        </param>
        <briefdescription>
<para>Computes the four constitutive operators used by an interface material. </para>
        </briefdescription>
        <detaileddescription>
<para>Condenses the bulk constitutive tensor with respect to the interface normal direction and derives the operators coupling displacement jumps, surface strains, interface forces, and surface stresses.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">normal</parametername>
</parameternamelist>
<parameterdescription>
<para>Unit normal vector of the interface. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">N</parametername>
</parameternamelist>
<parameterdescription>
<para>Normal projector <formula id="71">$\boldsymbol{n} \otimes \boldsymbol{n}$</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">C_nu_aibj</parametername>
</parameternamelist>
<parameterdescription>
<para>Fourth-order constitutive tensor.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Tuple containing, in order:<itemizedlist>
<listitem><para><formula id="76">$Z$</formula>: condensed fourth-order surface-strain operator,</para>
</listitem><listitem><para><formula id="77">$H^{-1}$</formula>: second-order displacement-jump operator,</para>
</listitem><listitem><para><formula id="78">$H^{-1}nF$</formula>: third-order jump/surface-strain coupling operator,</para>
</listitem><listitem><para><formula id="79">$nYH^{-1}Fn$</formula>: fourth-order coupling correction. </para>
</listitem></itemizedlist>
</para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
