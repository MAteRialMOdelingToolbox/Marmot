      <memberdef kind="function" id="_marmot_interface_material_helper_functions_8h_1a3c598f2a90d529affb22bd076d5dc700" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>std::tuple&lt; Tensor3333d, const Tensor3333d, Tensor3333d, Tensor33d &gt;</type>
        <definition>std::tuple&lt; Tensor3333d, const Tensor3333d, Tensor3333d, Tensor33d &gt; Marmot::Materials::InterfaceMaterialHelperFunctions::interfaceGeometrySystemCouplings</definition>
        <argsstring>(const Tensor33d &amp;N, const Tensor3333d &amp;L)</argsstring>
        <name>interfaceGeometrySystemCouplings</name>
        <qualifiedname>Marmot::Materials::InterfaceMaterialHelperFunctions::interfaceGeometrySystemCouplings</qualifiedname>
        <param>
          <type>const Tensor33d &amp;</type>
          <declname>N</declname>
        </param>
        <param>
          <type>const Tensor3333d &amp;</type>
          <declname>L</declname>
        </param>
        <briefdescription>
<para>Computes the geometry-system coupling tensors for an interface. </para>
        </briefdescription>
        <detaileddescription>
<para>Forms the contracted matrix <formula id="68">$Q = L:N$</formula> and its inverse <formula id="49">$G$</formula>, then computes the coupling tensor <formula id="69">$A = G \otimes N$</formula> and the condensed constitutive tensor <formula id="70">$B = L - L:A:L$</formula>.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">N</parametername>
</parameternamelist>
<parameterdescription>
<para>Normal projector <formula id="71">$\boldsymbol{n} \otimes \boldsymbol{n}$</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">L</parametername>
</parameternamelist>
<parameterdescription>
<para>Fourth-order constitutive tensor.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Tuple containing, in order:<itemizedlist>
<listitem><para><formula id="72">$B$</formula>: condensed fourth-order constitutive tensor,</para>
</listitem><listitem><para><formula id="73">$L$</formula>: unchanged input constitutive tensor,</para>
</listitem><listitem><para><formula id="74">$A$</formula>: fourth-order geometry-system coupling tensor,</para>
</listitem><listitem><para><formula id="75">$G = Q^{-1}$</formula>: inverse contracted constitutive matrix. </para>
</listitem></itemizedlist>
</para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
