      <memberdef kind="function" id="_marmot_monomial_basis_functions_8h_1afea7f214264b28e0378b8c007e5d450a" prot="public" static="no" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type>void</type>
        <definition>void Marmot::Math::computeMonomialBasisGradient</definition>
        <argsstring>(int order, const Eigen::Ref&lt; const Eigen::VectorXd &gt; &amp;x, Eigen::Ref&lt; Eigen::MatrixXd &gt; res)</argsstring>
        <name>computeMonomialBasisGradient</name>
        <qualifiedname>Marmot::Math::computeMonomialBasisGradient</qualifiedname>
        <param>
          <type>int</type>
          <declname>order</declname>
        </param>
        <param>
          <type>const Eigen::Ref&lt; const Eigen::VectorXd &gt; &amp;</type>
          <declname>x</declname>
        </param>
        <param>
          <type>Eigen::Ref&lt; Eigen::MatrixXd &gt;</type>
          <declname>res</declname>
        </param>
        <briefdescription>
<para>Evaluate the gradient <formula id="105">$ \partial \boldsymbol{H} / \partial \boldsymbol{x} $</formula> of the monomial basis (see <ref refid="class_marmot_1_1_math_1_1_monomial_basis" kindref="compound">MonomialBasis</ref>). </para>
        </briefdescription>
        <detaileddescription>
<para>Row <formula id="106">$ k $</formula> corresponds to entry <formula id="106">$ k $</formula> of computeMonomialBasis() (same ordering), column <formula id="23">$ i $</formula> to <formula id="107">$ \partial / \partial x_i $</formula>.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">order</parametername>
</parameternamelist>
<parameterdescription>
<para>Completeness order <formula id="89">$ n $</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">x</parametername>
</parameternamelist>
<parameterdescription>
<para>Coordinates <formula id="104">$ \boldsymbol{x} $</formula> (the dimension <formula id="87">$ d $</formula> is taken from its size). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">res</parametername>
</parameternamelist>
<parameterdescription>
<para>Gradient matrix; must already have the size computeSizeOfMonomialBasisVector( order, d ) <formula id="108">$ \times d $</formula>. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
