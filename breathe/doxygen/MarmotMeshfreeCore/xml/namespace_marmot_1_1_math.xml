      </memberdef>
      <memberdef kind="function" id="_marmot_monomial_basis_functions_8h_1abd4311e21ed9530de146ac55d62237ae" prot="public" static="no" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type>void</type>
        <definition>void Marmot::Math::computeMonomialBasisGradient</definition>
        <argsstring>(int order, const Eigen::VectorXd &amp;x, Eigen::MatrixXd &amp;res)</argsstring>
        <name>computeMonomialBasisGradient</name>
        <qualifiedname>Marmot::Math::computeMonomialBasisGradient</qualifiedname>
        <param>
          <type>int</type>
          <declname>order</declname>
        </param>
        <param>
          <type>const Eigen::VectorXd &amp;</type>
          <declname>x</declname>
        </param>
        <param>
          <type>Eigen::MatrixXd &amp;</type>
          <declname>res</declname>
        </param>
        <briefdescription>
<para>Evaluate the gradient <formula id="103">$ \partial \boldsymbol{H} / \partial \boldsymbol{x} $</formula> of the monomial basis. </para>
        </briefdescription>
        <detaileddescription>
<para>Row <formula id="90">$ k $</formula> corresponds to entry <formula id="90">$ k $</formula> of computeMonomialBasis() (same ordering), column <formula id="65">$ i $</formula> to <formula id="104">$ \partial / \partial x_i $</formula>.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">order</parametername>
</parameternamelist>
<parameterdescription>
<para>Completeness order <formula id="77">$ n $</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">x</parametername>
</parameternamelist>
<parameterdescription>
<para>Coordinates <formula id="5">$ \boldsymbol{x} $</formula> (the dimension <formula id="4">$ d $</formula> is taken from its size). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">res</parametername>
</parameternamelist>
<parameterdescription>
<para>Gradient matrix; must already have the size computeSizeOfMonomialBasisVector( order, d ) <formula id="94">$ \times d $</formula>. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
