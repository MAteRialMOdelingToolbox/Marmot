</parameterlist>
<simplesect kind="return"><para><formula id="98">$ 1 $</formula> if <formula id="330">$ z_i \le u &lt; z_{i+1} $</formula>, else <formula id="268">$ 0 $</formula>. </para>
</simplesect>
</para>
