      <memberdef kind="function" id="_marmot_monomial_basis_functions_8h_1aa2a829ce5fd1acd3352fded2e3dfa747" prot="public" static="no" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type>int</type>
        <definition>int Marmot::Math::_computeMonomialBasisRecursion</definition>
        <argsstring>(int order, const Eigen::VectorXd &amp;x, Eigen::VectorXd &amp;res, int idxEnd, int dim)</argsstring>
        <name>_computeMonomialBasisRecursion</name>
        <qualifiedname>Marmot::Math::_computeMonomialBasisRecursion</qualifiedname>
        <param>
          <type>int</type>
          <declname>order</declname>
        </param>
        <param>
          <type>const Eigen::VectorXd &amp;</type>
          <declname>x</declname>
        </param>
        <param>
          <type>Eigen::VectorXd &amp;</type>
          <declname>res</declname>
        </param>
        <param>
          <type>int</type>
          <declname>idxEnd</declname>
        </param>
        <param>
          <type>int</type>
          <declname>dim</declname>
        </param>
        <briefdescription>
<para>Recursive kernel of computeMonomialBasis(). </para>
        </briefdescription>
        <detaileddescription>
<para>Multiplies the entries starting at <computeroutput>idxEnd</computeroutput> by the powers <formula id="87">$ x_k^i $</formula> of the coordinates <formula id="88">$ k \le $</formula> <computeroutput>dim</computeroutput>, for all exponent combinations of total degree <formula id="89">$ \le $</formula> <computeroutput>order</computeroutput>. The loop over the exponent of coordinate <computeroutput>dim</computeroutput> is the outermost one, the recursion handles the lower coordinates.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">order</parametername>
</parameternamelist>
<parameterdescription>
<para>Remaining total degree. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">x</parametername>
</parameternamelist>
<parameterdescription>
<para>Coordinates. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="inout">res</parametername>
</parameternamelist>
<parameterdescription>
<para>Basis vector, initialized with ones by the caller. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">idxEnd</parametername>
</parameternamelist>
<parameterdescription>
<para>First entry of <computeroutput>res</computeroutput> treated by this call. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">dim</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of (leading) coordinates treated by this call. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>One past the last entry of <computeroutput>res</computeroutput> treated by this call. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
