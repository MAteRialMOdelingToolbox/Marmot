      </memberdef>
      <memberdef kind="function" id="_marmot_monomial_basis_functions_8h_1a2530f37cc311f34e4a19876d8e2e0f9f" prot="public" static="no" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type>void</type>
        <definition>void Marmot::Math::computeMonomialBasis</definition>
        <argsstring>(int order, const Eigen::Ref&lt; const Eigen::VectorXd &gt; &amp;x, Eigen::Ref&lt; Eigen::VectorXd &gt; res)</argsstring>
        <name>computeMonomialBasis</name>
        <qualifiedname>Marmot::Math::computeMonomialBasis</qualifiedname>
        <param>
          <type>int</type>
          <declname>order</declname>
        </param>
        <param>
          <type>const Eigen::Ref&lt; const Eigen::VectorXd &gt; &amp;</type>
          <declname>x</declname>
        </param>
        <param>
          <type>Eigen::Ref&lt; Eigen::VectorXd &gt;</type>
          <declname>res</declname>
        </param>
        <briefdescription>
<para>Evaluate the complete monomial basis <formula id="91">$ \boldsymbol{H}(\boldsymbol{x}) $</formula> of order <formula id="89">$ n $</formula> (see <ref refid="class_marmot_1_1_math_1_1_monomial_basis" kindref="compound">MonomialBasis</ref>, which lists its exponents once for many evaluations). </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">order</parametername>
</parameternamelist>
<parameterdescription>
<para>Completeness order <formula id="89">$ n $</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">x</parametername>
</parameternamelist>
<parameterdescription>
<para>Coordinates <formula id="104">$ \boldsymbol{x} $</formula> (the dimension <formula id="87">$ d $</formula> is taken from its size). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">res</parametername>
</parameternamelist>
<parameterdescription>
<para>Basis vector; must already have the size computeSizeOfMonomialBasisVector( order, d ). </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
