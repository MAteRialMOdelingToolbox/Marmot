        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">u</parametername>
</parameternamelist>
<parameterdescription>
<para>Parameter value <formula id="155">$ u $</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">knotVec</parametername>
</parameternamelist>
<parameterdescription>
<para>Knot vector <formula id="156">$ z $</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
