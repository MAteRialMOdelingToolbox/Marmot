      <memberdef kind="function" id="_marmot_b_spline_8h_1a8ae98f20896dadb847accf4691459301" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <templateparamlist>
          <param>
            <type>int</type>
            <declname>p</declname>
            <defname>p</defname>
          </param>
        </templateparamlist>
        <type>double</type>
        <definition>double Marmot::Math::dB_dU</definition>
        <argsstring>(double u, const double *knotVec, int i)</argsstring>
        <name>dB_dU</name>
        <qualifiedname>Marmot::Math::dB_dU</qualifiedname>
        <param>
          <type>double</type>
          <declname>u</declname>
        </param>
        <param>
          <type>const double *</type>
          <declname>knotVec</declname>
        </param>
        <param>
          <type>int</type>
          <declname>i</declname>
        </param>
        <briefdescription>
<para>Evaluate the derivative <formula id="150">$ \mathrm{d}N_{i,p}/\mathrm{d}u $</formula> of a B-spline basis function. </para>
        </briefdescription>
        <detaileddescription>
<para>Differentiates the Cox<ndash/>de Boor recursion of <ref refid="_marmot_b_spline_8h_1a2058ccd3b3618e8485c0786f6a330e11" kindref="member">B()</ref> term by term,    <formula id="158">\[  \frac{\mathrm{d}N_{i,p}}{\mathrm{d}u} = \frac{N_{i,p-1} + (u - z_i)\, N&apos;_{i,p-1}}{z_{i+p} - z_i}
  + \frac{-N_{i+1,p-1} + (z_{i+p+1} - u)\, N&apos;_{i+1,p-1}}{z_{i+p+1} - z_{i+1}},
\]</formula> omitting terms with a knot difference below <formula id="153">$ 10^{-14} $</formula>. The recursion ends at dB_dU&lt; 0 &gt; <formula id="159">$ = 0 $</formula>.</para>
<para><parameterlist kind="templateparam"><parameteritem>
<parameternamelist>
<parametername>p</parametername>
</parameternamelist>
<parameterdescription>
<para>Degree <formula id="135">$ p $</formula> of the B-spline. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">u</parametername>
</parameternamelist>
<parameterdescription>
<para>Parameter value <formula id="155">$ u $</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">knotVec</parametername>
</parameternamelist>
<parameterdescription>
<para>Knot vector <formula id="156">$ z $</formula>; entries <formula id="157">$ z_i, \dots, z_{i+p+1} $</formula> are accessed. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">i</parametername>
</parameternamelist>
<parameterdescription>
<para>Index <formula id="65">$ i $</formula> of the basis function. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><formula id="150">$ \mathrm{d}N_{i,p}/\mathrm{d}u $</formula>. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
