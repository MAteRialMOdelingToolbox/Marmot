      <memberdef kind="function" id="_marmot_b_spline_8h_1a2058ccd3b3618e8485c0786f6a330e11" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <templateparamlist>
          <param>
            <type>int</type>
            <declname>p</declname>
            <defname>p</defname>
          </param>
        </templateparamlist>
        <type>double</type>
        <definition>double Marmot::Math::B</definition>
        <argsstring>(double u, const double *knotVec, int i)</argsstring>
        <name>B</name>
        <qualifiedname>Marmot::Math::B</qualifiedname>
        <param>
          <type>double</type>
          <declname>u</declname>
        </param>
        <param>
          <type>const double *</type>
          <declname>knotVec</declname>
        </param>
        <param>
          <type>int</type>
          <declname>i</declname>
        </param>
        <briefdescription>
<para>Evaluate the B-spline basis function <formula id="148">$ N_{i,p}(u) $</formula> by the Cox<ndash/>de Boor recursion. </para>
        </briefdescription>
        <detaileddescription>
<para><formula id="151">\[  N_{i,p}(u) = \frac{u - z_i}{z_{i+p} - z_i} N_{i,p-1}(u)
             + \frac{z_{i+p+1} - u}{z_{i+p+1} - z_{i+1}} N_{i+1,p-1}(u),
\]</formula> where a term is omitted ( <formula id="152">$ 0/0 := 0 $</formula>) if its knot difference is below <formula id="153">$ 10^{-14} $</formula> (repeated knots). The recursion ends at B&lt; 0 &gt;.</para>
<para><parameterlist kind="templateparam"><parameteritem>
<parameternamelist>
<parametername>p</parametername>
</parameternamelist>
<parameterdescription>
<para>Degree <formula id="135">$ p $</formula> of the B-spline (order <formula id="154">$ p + 1 $</formula>). </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">u</parametername>
</parameternamelist>
<parameterdescription>
<para>Parameter value <formula id="155">$ u $</formula>. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">knotVec</parametername>
</parameternamelist>
<parameterdescription>
<para>Knot vector <formula id="156">$ z $</formula>; entries <formula id="157">$ z_i, \dots, z_{i+p+1} $</formula> are accessed. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">i</parametername>
</parameternamelist>
<parameterdescription>
<para>Index <formula id="65">$ i $</formula> of the basis function. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><formula id="148">$ N_{i,p}(u) $</formula>. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
