        <definition>void Marmot::Discretizations::Meshfree::Hoop::addStiffnessOfNode</definition>
        <argsstring>(double T_A, const Fastor::Tensor&lt; double, 2 &gt; &amp;dT_A_dx, double r, double deltaF33, double V0, double tau33, const Fastor::Tensor&lt; double, 2, 2 &gt; &amp;dTau_dDeltaF33, const Fastor::Tensor&lt; double, 2, 2 &gt; &amp;dTau33_dDeltaF, double dTau33_dDeltaF33, StiffnessOfNode&lt; 2, nDofPerNode &gt; &amp;ofNode)</argsstring>
        <name>addStiffnessOfNode</name>
        <qualifiedname>Marmot::Discretizations::Meshfree::Hoop::addStiffnessOfNode</qualifiedname>
        <param>
          <type>double</type>
          <declname>T_A</declname>
        </param>
        <param>
          <type>const Fastor::Tensor&lt; double, 2 &gt; &amp;</type>
          <declname>dT_A_dx</declname>
        </param>
        <param>
