        <type>void</type>
        <definition>void MarmotMaterialFiniteStrainAD::computeStress</definition>
        <argsstring>(ConstitutiveResponse&lt; 3 &gt; &amp;response, AlgorithmicModuli&lt; 3 &gt; &amp;tangents, const Deformation&lt; 3 &gt; &amp;deformation, const TimeIncrement &amp;timeIncrement) const override</argsstring>
        <name>computeStress</name>
