    <briefdescription>
<para>Algorithmic tangent moduli of a gradient-enhanced material. </para>
    </briefdescription>
    <detaileddescription>
<para><parameterlist kind="templateparam"><parameteritem>
<parameternamelist>
<parametername>nDim</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of spatial dimensions (2 or 3).</para>
</parameterdescription>
</parameteritem>
</parameterlist>
