        <definition>T Marmot::ContinuumMechanics::EnergyDensityFunctions::PenceGouPotentialC</definition>
        <argsstring>(const Tensor33t&lt; T &gt; &amp;C, const double K, const double G)</argsstring>
        <name>PenceGouPotentialC</name>
        <qualifiedname>Marmot::ContinuumMechanics::EnergyDensityFunctions::PenceGouPotentialC</qualifiedname>
        <param>
          <type>const Tensor33t&lt; T &gt; &amp;</type>
          <declname>C</declname>
        </param>
        <param>
          <type>const double</type>
          <declname>K</declname>
        </param>
        <param>
