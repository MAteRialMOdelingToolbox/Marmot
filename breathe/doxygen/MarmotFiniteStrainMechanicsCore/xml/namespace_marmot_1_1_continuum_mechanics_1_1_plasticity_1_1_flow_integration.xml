        <argsstring>(const Math::Tensors::FastorTensors::Tensor33t&lt; T &gt; &amp;dGp)</argsstring>
        <name>exponentialMapScalingAndSquaring</name>
        <qualifiedname>Marmot::ContinuumMechanics::Plasticity::FlowIntegration::exponentialMapScalingAndSquaring</qualifiedname>
