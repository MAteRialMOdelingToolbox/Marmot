#/* ---------------------------------------------------------------------
# *
# * CMake package configuration file for Marmot.
# *
# * After installation, downstream projects can locate Marmot with:
# *
# *   find_package(Marmot REQUIRED)
# *   target_link_libraries(<target> PRIVATE Marmot::Marmot)
# *
# * The Marmot::Marmot imported target carries the necessary include
# * directories and link libraries transitively.
# *
# * Prerequisites, located by the installed MarmotDependencies.cmake:
# *   - Eigen3   (Eigen3::Eigen)
# *   - autodiff (autodiff::autodiff; CMake package or plain headers)
# *   - Fastor   (Fastor::Fastor; CMake package or plain headers)
# *
# * ---------------------------------------------------------------------
# */

@PACKAGE_INIT@

# MarmotTargets.cmake references Eigen3::Eigen, autodiff::autodiff and Fastor::Fastor; recreate them the
# same way Marmot's own build found them before loading it.
include("${CMAKE_CURRENT_LIST_DIR}/MarmotDependencies.cmake")
if(NOT MARMOT_DEPENDENCIES_FOUND)
    set(Marmot_FOUND FALSE)
    set(Marmot_NOT_FOUND_MESSAGE "${MARMOT_DEPENDENCIES_MESSAGE}")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MarmotTargets.cmake")

check_required_components(Marmot)
