#/* ---------------------------------------------------------------------
# *
# * CMake package configuration file for Marmot.
# *
# * After installation, downstream projects can locate Marmot with:
# *
# *   find_package(Marmot REQUIRED)
# *   target_link_libraries(<target> PRIVATE Marmot::Marmot)
# *
# * The Marmot::Marmot imported target carries the necessary include
# * directories and link libraries transitively.
# *
# * Prerequisites that must be found by the consuming project:
# *   - Eigen3   (find_package(Eigen3 REQUIRED NO_MODULE))
# *   - autodiff (find_path(AUTODIFF_INCLUDE_DIR autodiff REQUIRED))
# *   - Fastor   (find_path(FASTOR_INCLUDE_DIR Fastor REQUIRED))
# *
# * ---------------------------------------------------------------------
# */

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Eigen3 is an imported target; ensure it is available before loading
# MarmotTargets.cmake which references Eigen3::Eigen.
find_dependency(Eigen3 3.3 REQUIRED NO_MODULE)

include("${CMAKE_CURRENT_LIST_DIR}/MarmotTargets.cmake")

check_required_components(Marmot)
