#/* ---------------------------------------------------------------------
# *
# * CMake package configuration file for Marmot.
# *
# * After installation, downstream projects can locate Marmot with:
# *
# *   find_package(Marmot REQUIRED)
# *   target_link_libraries(<target> PRIVATE Marmot::Marmot)
# *
# * The Marmot::Marmot imported target carries the necessary include
# * directories and link libraries transitively.
# *
# * Prerequisites resolved here on behalf of the consuming project:
# *   - Eigen3   (Eigen3::Eigen imported target)
# *   - autodiff (autodiff::autodiff imported target)
# *   - Fastor   (Fastor::Fastor imported target, with a plain header-search
# *               fallback for copies installed without CMake package files)
# *
# * ---------------------------------------------------------------------
# */

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# MarmotTargets.cmake references these imported targets; ensure they exist
# before loading it.
find_dependency(Eigen3 3.3 REQUIRED NO_MODULE)
find_dependency(autodiff)

# Fastor: prefer its CMake package; fall back to a plain header search
# (mirrors the logic in Marmot's top-level CMakeLists.txt).
find_package(Fastor QUIET)
if(NOT TARGET Fastor::Fastor)
    find_path(FASTOR_INCLUDE_DIR Fastor)
    if(NOT FASTOR_INCLUDE_DIR)
        set(Marmot_FOUND FALSE)
        set(Marmot_NOT_FOUND_MESSAGE "Marmot requires Fastor (CMake package or headers), but it was not found.")
        return()
    endif()
    add_library(Fastor::Fastor INTERFACE IMPORTED)
    set_target_properties(Fastor::Fastor PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${FASTOR_INCLUDE_DIR}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MarmotTargets.cmake")

check_required_components(Marmot)
